# Streamlit Secrets Configuration
# For local testing, copy this file to: .streamlit/secrets.toml or Main App/.streamlit/secrets.toml
# For Streamlit Community Cloud, paste the contents below into:
# App Settings -> Secrets in your Streamlit Cloud dashboard.

# Groq API Key for Apna AI Coach (LLM & Voice cues)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY = "your-groq-api-key-here"

# (Optional) Dedicated WebRTC TURN Relay Configuration
# If your network blocks direct WebRTC (strict corporate firewalls or symmetric mobile NAT),
# you can get free TURN credentials from Metered (https://www.metered.ca/tools/openrelay/):
# [webrtc]
# turn_url = "turn:global.relay.metered.ca:80"
# turn_username = "your_username"
# turn_credential = "your_credential"
